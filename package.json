{
  "name": "center-for-digital-democracy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-sqlite --no-warnings ./node_modules/next/dist/bin/next dev",
    "build": "node --experimental-sqlite --no-warnings ./node_modules/next/dist/bin/next build && node scripts/prepare-standalone.mjs",
    "start": "node --experimental-sqlite --no-warnings .next/standalone/server.js",
    "preview": "npm start",
    "lint": "eslint",
    "test": "node --experimental-sqlite --no-warnings ./node_modules/vitest/vitest.mjs run",
    "test:atlas-import": "node --experimental-sqlite --no-warnings --import tsx scripts/atlas/ci-continuity.ts",
    "seo:assets": "node scripts/generate-seo-assets.mjs",
    "import:data": "node --import tsx scripts/import/cli.ts",
    "import:countries": "node --import tsx scripts/import/countries.ts",
    "migrate:atlas": "node --experimental-sqlite --no-warnings --import tsx scripts/atlas/migrate.ts",
    "import:atlas": "node --experimental-sqlite --no-warnings --import tsx scripts/atlas/import.ts",
    "validate:data": "node --import tsx scripts/validate/cli.ts",
    "validate:evidence": "node --import tsx scripts/validate/release-evidence.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
