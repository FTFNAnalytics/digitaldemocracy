{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "lib/atlas/node-sqlite.d.ts"
  ],
  "exclude": [
    "node_modules",
    "docs/phase1/sweden/contract-snapshots",
    "docs/phase1/finland/contracts",
    "docs/phase1/ireland/contracts",
    "docs/phase1/poland/contracts",
    "docs/phase1/estonia/contract-reference",
    "docs/phase1/latvia/contract-reference",
    "docs/phase1/lithuania/contract-reference",
    "docs/phase1/slovakia/contract-reference"
  ]
}
