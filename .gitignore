# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bulky research archives — keep checksums in Git, not the zip
*.zip
/data/incoming/*
!/data/incoming/.gitkeep
!/data/incoming/README.md
/data/raw/
/data/releases/reconciliation-report.json

# Transactional import staging and recovery copies
/data/research.staging/
/data/research.previous/
